{
  "name": "symfony-spanner-test",
  "version": "1.0.0",
  "description": "Testing connecting Symfony to Google Cloud Spanner",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start:emulator": "docker run -p 9010:9010 -p 9020:9020 gcr.io/cloud-spanner-emulator/emulator",
    "start": "symfony server:start",
    "spanner:sql": "gcloud spanner databases execute-sql emulator --instance=spanner-emulator",
    "fail": "bin/console doctrine:schema:update --dump-sql 2>&1 >err.log"
  },
  "author": "Marco Buschini <marco.buschini@gmail.com>",
  "license": "MIT"
}
